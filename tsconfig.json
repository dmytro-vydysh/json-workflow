{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "types": [
      "jest",
      "node"
    ],
    "declarationMap": true,
    "removeComments": true,
    "strict": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": [
    "./src/**/*"
  ],
}